      "apx_places": ["b1…0001"],
      "user": "agent:j.okafor"
    },
    "host-console": {
      "scopes": ["apx.ui:launch", "apx.ui:read", "apx.control:read", "apx.resolution:read", "apx.support:manage"],
      "apx_org": { "id": "a1…0001", "className": "Organisation" },
